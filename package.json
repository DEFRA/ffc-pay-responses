{
  "name": "ffc-pay-responses",
  "version": "1.10.44",
  "description": "FFC payment response processing",
  "homepage": "https://github.com/DEFRA/ffc-pay-responses",
  "main": "app/index.js",
  "scripts": {
    "pretest": "npm run test:lint",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --coverage=false --onlyChanged --watch --runInBand",
    "test:lint": "eslint",
    "test:lint:fix": "eslint --fix",
    "test:debug": "node --inspect-brk=0.0.0.0 ./node_modules/jest/bin/jest.js --coverage=false --onlyChanged --watch --runInBand --no-cache",
    "start:watch": "nodemon --inspect=0.0.0.0 --ext js --legacy-watch app/index.js",
    "start:debug": "nodemon --inspect-brk=0.0.0.0 --ext js --legacy-watch app/index.js",
    "prepare": "node --eval \"const fs=require('fs'),cp=require('child_process');if(fs.existsSync('.git')&&!process.env.CI&&!process.env.TF_BUILD)cp.execSync('husky',{stdio:'inherit'})\""
  },
  "author": "Defra",
  "contributors": [
    "John Watson john.watson1@defra.gov.uk",
    "Steve Dickinson steve.dickinson@defra.gov.uk",
    "Marc Templeton m.templeton@kainos.com",
    "Kirsten Williamson kirsten.williamson@kainos.com",
    "Sam Plackett samuel.plackett@atos.net",
    "John Barnard john.barnard.external@atos.net",
    "Leigh Godson leigh.godson@atos.net",
    "Alistair Wishart alistair.wishart@atos.net"
  ],
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@azure/identity": "4.4.1",
    "@azure/monitor-opentelemetry": "1.19.0",
    "@azure/storage-blob": "12.31.0",
    "@hapi/hapi": "21.4.0",
    "ffc-database": "1.0.27",
    "ffc-messaging": "2.10.8",
    "ffc-pay-event-publisher": "1.2.7",
    "hapi-pino": "13.0.0",
    "log-timestamp": "0.3.0",
    "moment": "2.29.4",
    "sequelize": "6.37.8",
    "xml2js": "0.6.2"
  },
  "devDependencies": {
    "blipp": "4.0.2",
    "eslint": "9.39.1",
    "husky": "9.1.7",
    "jest": "29.6.4",
    "jest-junit": "17.0.0",
    "neostandard": "0.12.2",
    "nodemon": "3.1.14"
  },
  "nodemonConfig": {
    "ignore": [
      "**/test-output/**"
    ]
  },
  "overrides": {
    "@opentelemetry/propagator-jaeger": "2.9.0",
    "brace-expansion": "5.0.8",
    "uuid": "11.1.1"
  }
}
